#!/bin/sh
# Настройка SUID-хелпера sandbox Chromium (работает при установке от root:
# sudo dpkg -i / sudo apt install ./...). Песочница включается галочкой в
# «Настройки → Графика» (по умолчанию выключена, см. run.sh); без хелпера
# приложение работает с --no-sandbox.
SB=/opt/dsh-launcher/electron/chrome-sandbox
if [ -f "$SB" ]; then
  chown root:root "$SB" 2>/dev/null || true
  chmod 4755 "$SB" 2>/dev/null || true
fi
exit 0
